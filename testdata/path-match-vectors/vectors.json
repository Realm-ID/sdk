{
  "spec": "sdk/SPEC.md §11.4.1 (SPEC11_4_1_canon), §10.2, §10.4; decided 2026-11-14 (audit e-03/e-04)",
  "version": 1,
  "matcher_case_count": 42,
  "request_case_count": 25,
  "notes": [
    "matcher: canonicalMatch(pattern, kind, path) -> bool. Language-independent; every SDK MUST give exactly 'match'.",
    "kind: exempt (exemptPaths), mfa (mfaProtectedPaths), scope (ScopeRule.path). {name} is a placeholder for mfa and scope only; exempt keeps braces literal.",
    "path strings are given exactly as the matcher receives them; the matcher NEVER percent-decodes, collapses '//', or resolves dot segments.",
    "request: the per-language path SOURCE (SPEC11_4_1_source). 'seen' is the string handed to canonicalMatch, or the literal \"400\" for a request the SDK refuses with 400 invalid_path before matching. 'mfa_rule' is the first rule of request_rules.mfa that matches 'seen', or null.",
    "java inputs are the servlet triple a FakeReq returns (request_uri raw; servlet_path and path_info already decoded with ;params removed, as the container hands them over). The runner feeds them verbatim; container behaviour is not under test."
  ],
  "matcher": [
    {"id": "m01", "kind": "mfa",    "pattern": "/admin/*",            "path": "/admin/users",            "match": true,  "why": "baseline"},
    {"id": "m02", "kind": "mfa",    "pattern": "/admin/*",            "path": "/Admin/users",            "match": true,  "why": "ASCII case-insensitive literal (e-04)"},
    {"id": "m03", "kind": "mfa",    "pattern": "/admin/*",            "path": "/ADMIN/USERS",            "match": true,  "why": "ASCII case-insensitive literal"},
    {"id": "m04", "kind": "mfa",    "pattern": "/billing/charge",     "path": "/Billing/Charge",         "match": true,  "why": "ASCII case-insensitive literal"},
    {"id": "m05", "kind": "scope",  "pattern": "/orders/export",      "path": "/orders/Export",          "match": true,  "why": "case-folded literal: the specific rule wins for /orders/Export"},
    {"id": "m06", "kind": "scope",  "pattern": "/orders/{id}",        "path": "/ORDERS/42",              "match": true,  "why": "literal around a placeholder folds"},
    {"id": "m07", "kind": "exempt", "pattern": "/public/*",           "path": "/PUBLIC/x",               "match": true,  "why": "exempt folds too: one matcher, no options"},
    {"id": "m08", "kind": "mfa",    "pattern": "/desk",               "path": "/deſk",              "match": false, "why": "U+017F LONG S is not ASCII; it never folds to 's' (Go (?i) would fold it: do not use regex case flags)"},
    {"id": "m09", "kind": "mfa",    "pattern": "/kiosk",              "path": "/Kiosk",             "match": false, "why": "U+212A KELVIN SIGN never folds to 'k'"},
    {"id": "m10", "kind": "mfa",    "pattern": "/café",          "path": "/CAFÉ",              "match": false, "why": "non-ASCII letters compare exactly (JS /i without /u would fold E-acute)"},
    {"id": "m11", "kind": "mfa",    "pattern": "/café",          "path": "/CAFé",              "match": true,  "why": "ASCII letters fold, the non-ASCII one is equal"},
    {"id": "m12", "kind": "mfa",    "pattern": "/admin/*",            "path": "/admin/users/",           "match": true,  "why": "one trailing slash ignored (e-04)"},
    {"id": "m13", "kind": "mfa",    "pattern": "/billing/charge",     "path": "/billing/charge/",        "match": true,  "why": "one trailing slash ignored"},
    {"id": "m14", "kind": "scope",  "pattern": "/orders/{id}",        "path": "/orders/42/",             "match": true,  "why": "CHANGED from v0.63 table (was no)"},
    {"id": "m15", "kind": "scope",  "pattern": "/orders/{id}/",       "path": "/orders/42",              "match": true,  "why": "a trailing slash on the PATTERN is ignored too"},
    {"id": "m16", "kind": "scope",  "pattern": "/orders/{id}/",       "path": "/orders/42/",             "match": true,  "why": "both sides trimmed"},
    {"id": "m17", "kind": "mfa",    "pattern": "/billing/charge",     "path": "/billing/charge//",       "match": false, "why": "exactly ONE trailing slash is ignored; the second is an empty segment"},
    {"id": "m18", "kind": "scope",  "pattern": "/orders/*",           "path": "/orders/",                "match": false, "why": "CHANGED from v0.63 table (was yes): /orders/ is /orders, which /orders/* never matched"},
    {"id": "m19", "kind": "scope",  "pattern": "/orders/**",          "path": "/orders/",                "match": true,  "why": "/x/** matches the bare /x"},
    {"id": "m20", "kind": "exempt", "pattern": "/x/**",               "path": "/x",                      "match": true,  "why": "unchanged since v0.63"},
    {"id": "m21", "kind": "exempt", "pattern": "/health",             "path": "/health/",                "match": true,  "why": "trailing slash, exempt list"},
    {"id": "m22", "kind": "scope",  "pattern": "/orders/{id}",        "path": "/orders/",                "match": false, "why": "{name} never matches an empty segment, and /orders/ is /orders"},
    {"id": "m23", "kind": "mfa",    "pattern": "/admin/*",            "path": "/admin//users",           "match": false, "why": "'//' is not collapsed: an empty segment then 'users'"},
    {"id": "m24", "kind": "mfa",    "pattern": "/admin/**",           "path": "/admin//users",           "match": true,  "why": "** spans the empty segment"},
    {"id": "m25", "kind": "scope",  "pattern": "/orders/{id}",        "path": "/orders//42",             "match": false, "why": "unchanged from v0.63"},
    {"id": "m26", "kind": "mfa",    "pattern": "/billing/charge",     "path": "//billing/charge",        "match": false, "why": "leading '//' is an empty first segment"},
    {"id": "m27", "kind": "exempt", "pattern": "/public/**",          "path": "/public/../admin/x",      "match": true,  "why": "dot segments are literal text to the matcher; Java refuses them before matching (request r12)"},
    {"id": "m28", "kind": "mfa",    "pattern": "/admin/*",            "path": "/admin/./users",          "match": false, "why": "'.' is a literal segment"},
    {"id": "m29", "kind": "mfa",    "pattern": "/admin/**",           "path": "/admin/../public",        "match": true,  "why": "literal: ** spans '..' and 'public'"},
    {"id": "m30", "kind": "mfa",    "pattern": "/admin/*",            "path": "/%61dmin/users",          "match": false, "why": "the matcher never decodes; decoding is the path SOURCE's job"},
    {"id": "m31", "kind": "scope",  "pattern": "/files/{id}",         "path": "/files/a%2Fb",            "match": true,  "why": "%2F is three literal characters inside one segment"},
    {"id": "m32", "kind": "mfa",    "pattern": "/billing/charge",     "path": "/billing/%63harge",       "match": false, "why": "no decoding in the matcher"},
    {"id": "m33", "kind": "mfa",    "pattern": "/billing/%63harge",   "path": "/billing/%63HARGE",       "match": true,  "why": "literal pattern text folds like any other ASCII"},
    {"id": "m34", "kind": "mfa",    "pattern": "/billing/charge",     "path": "/billing/charge;v=1",     "match": false, "why": "';' is literal to the matcher (Java strips it in the SOURCE, r05)"},
    {"id": "m35", "kind": "mfa",    "pattern": "/admin/*",            "path": "/admin;x=1/users",        "match": false, "why": "';' is literal"},
    {"id": "m36", "kind": "scope",  "pattern": "/orders/{id}",        "path": "/orders/42;v=1",          "match": true,  "why": "one segment '42;v=1'"},
    {"id": "m37", "kind": "mfa",    "pattern": "/orders/{id}/refund", "path": "/ORDERS/42/REFUND",       "match": true,  "why": "placeholder in mfa list, literals fold"},
    {"id": "m38", "kind": "exempt", "pattern": "/orders/{id}",        "path": "/orders/42",              "match": false, "why": "exemptPaths keeps braces literal (owner ruling 2026-10-01)"},
    {"id": "m39", "kind": "exempt", "pattern": "/orders/{id}",        "path": "/ORDERS/{ID}",            "match": true,  "why": "literal brace text, ASCII folded"},
    {"id": "m40", "kind": "scope",  "pattern": "/orgs/{org}/files/**","path": "/Orgs/acme/Files",        "match": true,  "why": "placeholder + ** + fold"},
    {"id": "m41", "kind": "mfa",    "pattern": "/a/**/b",             "path": "/A/x/B",                  "match": true,  "why": "mid-pattern ** keeps its segment boundary; literals fold"},
    {"id": "m42", "kind": "mfa",    "pattern": "/a/**/b",             "path": "/ab",                     "match": false, "why": "segment boundary kept (go 0.67.0 fix)"}
  ],
  "request_rules": {
    "mfa": ["/admin/*", "/billing/charge", "/orders/{id}/refund"]
  },
  "request": [
    {"id": "r01", "target": "/admin/users",
     "java": {"request_uri": "/admin/users", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "/admin/users", "mfa_rule": "/admin/*"}, "ts": {"seen": "/admin/users", "mfa_rule": "/admin/*"}, "java_expect": {"seen": "/admin/users", "mfa_rule": "/admin/*"}},
    {"id": "r02", "target": "/Admin/users/",
     "java": {"request_uri": "/Admin/users/", "servlet_path": "/Admin/users/", "path_info": null},
     "go": {"seen": "/Admin/users/", "mfa_rule": "/admin/*"}, "ts": {"seen": "/Admin/users/", "mfa_rule": "/admin/*"}, "java_expect": {"seen": "/Admin/users/", "mfa_rule": "/admin/*"}},
    {"id": "r03", "target": "/%61dmin/users",
     "java": {"request_uri": "/%61dmin/users", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "/admin/users", "mfa_rule": "/admin/*"}, "ts": {"seen": "/%61dmin/users", "mfa_rule": null}, "java_expect": {"seen": "/admin/users", "mfa_rule": "/admin/*"},
     "why": "go: r.URL.Path is decoded by net/url; ts: raw, as Express routes it; java: decoded servlet path (e-03)"},
    {"id": "r04", "target": "/billing/%63harge",
     "java": {"request_uri": "/billing/%63harge", "servlet_path": "/billing/charge", "path_info": null},
     "go": {"seen": "/billing/charge", "mfa_rule": "/billing/charge"}, "ts": {"seen": "/billing/%63harge", "mfa_rule": null}, "java_expect": {"seen": "/billing/charge", "mfa_rule": "/billing/charge"}},
    {"id": "r05", "target": "/billing/charge;v=1",
     "java": {"request_uri": "/billing/charge;v=1", "servlet_path": "/billing/charge", "path_info": null},
     "go": {"seen": "/billing/charge;v=1", "mfa_rule": null}, "ts": {"seen": "/billing/charge;v=1", "mfa_rule": null}, "java_expect": {"seen": "/billing/charge", "mfa_rule": "/billing/charge"},
     "why": "java: a raw ';' is allowed, the servlet path has already stripped it (e-03 J4)"},
    {"id": "r06", "target": "/admin;x=1/users",
     "java": {"request_uri": "/admin;x=1/users", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "/admin;x=1/users", "mfa_rule": null}, "ts": {"seen": "/admin;x=1/users", "mfa_rule": null}, "java_expect": {"seen": "/admin/users", "mfa_rule": "/admin/*"}},
    {"id": "r07", "target": "/admin%2Fusers",
     "java": {"request_uri": "/admin%2Fusers", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/admin%2Fusers", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "go: EscapedPath() holds %2F (owner ruling 9, 2026-11-14)"},
    {"id": "r08", "target": "/orders/42%2frefund",
     "java": {"request_uri": "/orders/42%2frefund", "servlet_path": "/orders/42/refund", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/orders/42%2frefund", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "the go and java refusals are hex-case-insensitive (%2f)"},
    {"id": "r09", "target": "/admin%5Cusers",
     "java": {"request_uri": "/admin%5Cusers", "servlet_path": "/admin\\users", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/admin%5Cusers", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "go TRAP: r.URL.RawPath is EMPTY here (net/url keeps RawPath only when it differs from the default escaping); EscapedPath() is /admin%5Cusers"},
    {"id": "r10", "target": "/%2561dmin/users",
     "java": {"request_uri": "/%2561dmin/users", "servlet_path": "/%61dmin/users", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/%2561dmin/users", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "double encoding: go and java refuse a raw %25 (go: RawPath is EMPTY here too; EscapedPath() is /%2561dmin/users)"},
    {"id": "r11", "target": "/public/%2e%2e/admin/users",
     "java": {"request_uri": "/public/%2e%2e/admin/users", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/public/%2e%2e/admin/users", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "go: the dot-segment test runs on the DECODED r.URL.Path (/public/../admin/users), so an encoded '..' is refused like a literal one (owner ruling 16)"},
    {"id": "r12", "target": "/public/../admin/users",
     "java": {"request_uri": "/public/../admin/users", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/public/../admin/users", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "java: a raw dot segment is refused even though the servlet path resolved it; go refuses it too (owner ruling 16)"},
    {"id": "r13", "target": "/admin/./users",
     "java": {"request_uri": "/admin/./users", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/admin/./users", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null}},
    {"id": "r14", "target": "/public/..;/admin/users",
     "java": {"request_uri": "/public/..;/admin/users", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/public/..;/admin/users", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "go and java: a segment is a dot segment after its ;params are removed ('..;' is '..')"},
    {"id": "r15", "target": "/admin//users",
     "java": {"request_uri": "/admin//users", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "/admin//users", "mfa_rule": null}, "ts": {"seen": "/admin//users", "mfa_rule": null}, "java_expect": {"seen": "/admin/users", "mfa_rule": "/admin/*"},
     "why": "java input models a container that merges slashes in the servlet path; '//' is not on the java refusal list"},
    {"id": "r16", "target": "/myapp/billing/charge",
     "java": {"request_uri": "/myapp/billing/charge", "servlet_path": "/billing/charge", "path_info": null},
     "go": {"seen": "/myapp/billing/charge", "mfa_rule": null}, "ts": {"seen": "/myapp/billing/charge", "mfa_rule": null}, "java_expect": {"seen": "/billing/charge", "mfa_rule": "/billing/charge"},
     "why": "java: context path /myapp is not part of servletPath+pathInfo (e-03 context-path row)"},
    {"id": "r17", "target": "/admin/users?next=/billing/charge",
     "java": {"request_uri": "/admin/users", "servlet_path": "/admin/users", "path_info": null},
     "go": {"seen": "/admin/users", "mfa_rule": "/admin/*"}, "ts": {"seen": "/admin/users", "mfa_rule": "/admin/*"}, "java_expect": {"seen": "/admin/users", "mfa_rule": "/admin/*"},
     "why": "the query is never part of the path"},
    {"id": "r18", "target": "/public/.well-known/x",
     "java": {"request_uri": "/public/.well-known/x", "servlet_path": "/public/.well-known/x", "path_info": null},
     "go": {"seen": "/public/.well-known/x", "mfa_rule": null}, "ts": {"seen": "/public/.well-known/x", "mfa_rule": null}, "java_expect": {"seen": "/public/.well-known/x", "mfa_rule": null},
     "why": "'.well-known' is not a dot segment"},
    {"id": "r19", "target": "/BILLING/CHARGE/",
     "java": {"request_uri": "/BILLING/CHARGE/", "servlet_path": "/BILLING/CHARGE/", "path_info": null},
     "go": {"seen": "/BILLING/CHARGE/", "mfa_rule": "/billing/charge"}, "ts": {"seen": "/BILLING/CHARGE/", "mfa_rule": "/billing/charge"}, "java_expect": {"seen": "/BILLING/CHARGE/", "mfa_rule": "/billing/charge"}},
    {"id": "r20", "target": "/admin/%2Eenv",
     "java": {"request_uri": "/admin/%2Eenv", "servlet_path": "/admin/.env", "path_info": null},
     "go": {"seen": "/admin/.env", "mfa_rule": "/admin/*"}, "ts": {"seen": "/admin/%2Eenv", "mfa_rule": "/admin/*"}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "java refuses ANY raw %2E, not only one forming a dot segment"},
    {"id": "r21", "target": "/app/admin/users",
     "java": {"request_uri": "/app/admin/users", "servlet_path": "/app", "path_info": "/admin/users"},
     "go": {"seen": "/app/admin/users", "mfa_rule": null}, "ts": {"seen": "/app/admin/users", "mfa_rule": null}, "java_expect": {"seen": "/app/admin/users", "mfa_rule": null},
     "why": "java: servletPath + pathInfo, concatenated (a servlet mapped at /app/*)"},
    {"id": "r22", "target": "/admin%5cusers",
     "java": {"request_uri": "/admin%5cusers", "servlet_path": "/admin\\users", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/admin%5cusers", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "lower-case hex; go: RawPath IS set here (/admin%5cusers), so a RawPath-only check would catch r22 and miss r09"},
    {"id": "r23", "target": "/admin\\users",
     "java": {"request_uri": "/admin\\users", "servlet_path": "/admin\\users", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/admin\\users", "mfa_rule": null}, "java_expect": {"seen": "/admin\\users", "mfa_rule": null},
     "why": "a LITERAL backslash: go refuses it explicitly (SPEC11_4_1_source), so the wire-text and fallback branches agree; java checks only encodings (Tomcat refuses a raw backslash itself by default; not under test); ts matches it raw, no rule"},
    {"id": "r24", "target": "/files/a%2Fb|",
     "java": {"request_uri": "/files/a%2Fb|", "servlet_path": "/files/a/b|", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/files/a%2Fb|", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "doc-review row 3: '|' fails net/url validEncoded, so EscapedPath() re-escapes the DECODED path as /files/a/b%7C and loses the %2F; the wire text r.RequestURI keeps it"},
    {"id": "r25", "target": "/admin%5Cusers{",
     "java": {"request_uri": "/admin%5Cusers{", "servlet_path": "/admin\\users{", "path_info": null},
     "go": {"seen": "400", "mfa_rule": null}, "ts": {"seen": "/admin%5Cusers{", "mfa_rule": null}, "java_expect": {"seen": "400", "mfa_rule": null},
     "why": "the row-3 shape with %5C and '{': EscapedPath() is /admin%5Cusers%7B and still holds %5C (a decoded '\\' re-escapes to %5C), so this is a regression case for the wire-text check"}
  ]
}
