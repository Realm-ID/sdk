{
  "name": "@realmid/web-bff-realmid",
  "version": "0.3.2",
  "description": "Drop-in adapter preset wiring @realmid/web to the realmid.dev reference BFF (Realm-ID/api).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
