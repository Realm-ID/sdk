    "directory": "web/packages/bff-realmid"
  },
  "license": "MIT",
  "peerDependencies": {
    "@realmid/web": "^0.4.0"
  },
  "devDependencies": {
    "@realmid/web": "^0.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
