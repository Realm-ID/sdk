{
  "name": "@realm-id/web-admin",
  "version": "0.8.12",
  "description": "Admin-UI SDK for RealmID \u2014 wraps @realm-id/sdk resource classes on top of an @realm-id/web transport.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test --import tsx --test-reporter=spec src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "realmid",
    "admin",
    "browser",
    "sdk"
  ],
  "homepage": "https://realmid.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Realm-ID/sdk.git",
    "directory": "web/packages/admin"
  },
  "license": "MIT",
  "peerDependencies": {
    "@realm-id/web": "^0.4.0"
  },
  "dependencies": {
    "@realm-id/sdk": "file:../../../ts"
  },
  "bundledDependencies": [
    "@realm-id/sdk"
  ],
  "devDependencies": {
    "@realm-id/web": "^0.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
