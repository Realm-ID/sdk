{
  "name": "@realmid/web-admin",
  "version": "0.1.1",
  "description": "Admin-UI SDK for RealmID — wraps @realmid/sdk resource classes on top of an @realmid/web transport.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "node --test --import tsx --test-reporter=spec src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["realmid", "admin", "browser", "sdk"],
  "homepage": "https://realmid.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Realm-ID/sdk.git",
    "directory": "web/packages/admin"
  },
  "license": "MIT",
  "peerDependencies": {
    "@realmid/web": "^0.4.0"
  },
  "dependencies": {
    "@realmid/sdk": "file:../../../ts"
  },
  "bundledDependencies": ["@realmid/sdk"],
  "devDependencies": {
    "@realmid/web": "^0.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
